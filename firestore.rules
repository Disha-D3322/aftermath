rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        role in getUserData().roles || 
        'admin' in getUserData().roles
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles: users can read their own or authorized reviewers can read.
    // Privileged roles cannot be self-modified by the client.
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && 
        (!request.resource.data.keys().hasAny(['roles']) || request.resource.data.roles == ['user']);
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'verifiedPoints']);
      allow delete: if hasRole('admin');
    }

    // Reports: survivors can create reports. All authenticated users can read.
    // Only reviewers/coordinators can change verification status.
    match /reports/{reportId} {
      allow read: if true; // Public safety transparency
      allow create: if true; // Survivors can submit even anonymously
      allow update: if hasRole('reviewer') || hasRole('coordinator') || (
        isAuthenticated() && resource.data.reporterId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'aiTriage', 'incidentId'])
      );
      allow delete: if hasRole('admin');
    }

    // Consolidated Incidents: public read; write restricted to reviewers/coordinators
    match /incidents/{incidentId} {
      allow read: if true;
      allow create, update: if hasRole('reviewer') || hasRole('coordinator');
      allow delete: if hasRole('admin');
    }

    // Append-Only Review Action Audit Trail: cannot be edited or deleted once written
    match /reviewActions/{actionId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('reviewer') || hasRole('coordinator');
      allow update, delete: if false; // STRICT IMMUTABILITY
    }

    // Volunteer Profiles: public can read, owner can update availability & skills.
    // Points CANNOT be updated directly by client.
    match /volunteerProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedPoints', 'badges']);
      allow delete: if hasRole('admin');
    }

    // Tasks: available for volunteers to read; write restricted to coordinators
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update: if hasRole('coordinator') || hasRole('reviewer');
      allow delete: if hasRole('admin');
    }

    // Contributions (Points Ledger): immutable, only created by trusted backend/coordinators
    match /contributions/{contribId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('coordinator') || hasRole('admin');
      allow update, delete: if false; // IMMUTABLE IDEMPOTENT RECORD
    }

    // Corporate Organizations: readable by all, writable by org members or admin
    match /organizations/{orgId} {
      allow read: if true;
      allow create, update: if hasRole('admin') || (
        hasRole('corporate_partner') && getUserData().organizationId == orgId
      );
    }

    // Resource Pledges: org-scoped write
    match /resourceContributions/{pledgeId} {
      allow read: if isAuthenticated();
      allow create, update: if hasRole('admin') || (
        hasRole('corporate_partner') && getUserData().organizationId == request.resource.data.organizationId
      );
    }

    // Notifications: owner read/write
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.recipientUserId == request.auth.uid;
      allow create: if isAuthenticated();
    }
  }
}
