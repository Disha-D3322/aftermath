rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Survivor attachments: image and audio only, size limit 15MB
    match /reports/{reportId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') 
                       || request.resource.contentType.matches('audio/.*'));
    }

    // Task verification evidence: size limit 10MB
    match /evidence/{taskId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
